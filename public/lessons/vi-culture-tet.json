{"id":"vi-culture-tet","schemaVersion":1,"origin":"catalog","title":{"original":"Tết Nguyên Đán","en":"Tết: The Lunar New Year","ja":"テト（ベトナムの旧正月）"},"description":{"vi":"Người Việt đón Tết như thế nào: dọn nhà, gói bánh chưng, lì xì và đi thăm họ hàng.","en":"How Vietnamese families celebrate Tết: cleaning the house, making bánh chưng, lucky money and family visits.","ja":"大掃除、バインチュン作り、お年玉、親戚訪問など、ベトナムの家族のテトの過ごし方です。"},"targetLanguage":"vi","supportLanguages":["en","ja"],"media":{"kind":"file","mediaType":"audio","url":"media/vi-culture-tet.mp3"},"durationSec":30.51,"sentenceCount":13,"categories":["culture","family"],"tags":["tet","lunar new year","holidays","traditions","family"],"difficulty":{"framework":"vi-level","level":"beginner"},"accent":"vi-north","speakers":["Minh Quân Pro"],"source":{"kind":"prepared","synthetic":true,"attribution":"Mimane demo lesson · VieNeu-TTS v3 Turbo (Minh Quân Pro)","license":"CC BY 4.0"},"author":"Mimane","createdAt":"2026-09-26T11:14:48.889Z","updatedAt":"2026-09-26T11:14:48.889Z","sentences":[{"id":"vi-culture-tet#0","index":0,"start":0.4,"end":2.188,"text":"Tết Nguyên Đán là Tết cổ truyền của người Việt.","translations":{"en":"Tết Nguyên Đán is the traditional New Year of the Vietnamese.","ja":"テト・グエンダンはベトナム人の伝統的なお正月です。"},"analysis":{"lang":"vi","tokens":[{"surface":"Tết Nguyên Đán","isWord":true,"lemma":"tết nguyên đán","lexKey":"tết nguyên đán","syllables":[{"text":"Tết","initial":"t","medial":"","nucleus":"ê","final":"t","tone":"sac"},{"text":"Nguyên","initial":"ng","medial":"u","nucleus":"yê","final":"n","tone":"ngang"},{"text":"Đán","initial":"đ","medial":"","nucleus":"a","final":"n","tone":"sac"}],"pos":"noun"},{"surface":" ","isWord":false},{"surface":"là","isWord":true,"lemma":"là","lexKey":"là","syllables":[{"text":"là","initial":"l","medial":"","nucleus":"a","final":"","tone":"huyen"}],"pos":"verb"},{"surface":" ","isWord":false},{"surface":"Tết","isWord":true,"lemma":"tết","lexKey":"tết","syllables":[{"text":"Tết","in