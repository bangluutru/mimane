の花が好まれます。"},"analysis":{"lang":"vi","tokens":[{"surface":"Ở","isWord":true,"lemma":"ở","lexKey":"ở","syllables":[{"text":"Ở","initial":"","medial":"","nucleus":"ơ","final":"","tone":"hoi"}],"pos":"preposition"},{"surface":" ","isWord":false},{"surface":"miền Nam","isWord":true,"lemma":"miền nam","lexKey":"miền nam","syllables":[{"text":"miền","initial":"m","medial":"","nucleus":"iê","final":"n","tone":"huyen"},{"text":"Nam","initial":"n","medial":"","nucleus":"a","final":"m","tone":"ngang"}],"pos":"noun"},{"surface":",","isWord":false},{"surface":" ","isWord":false},{"surface":"người ta","isWord":true,"lemma":"người ta","lexKey":"người ta","syllables":[{"text":"người","initial":"ng","medial":"","nucleus":"ươ","final":"i","tone":"huyen"},{"text":"ta","initial":"t","medial":"","nucleus":"a","final":"","tone":"ngang"}],"pos":"pronoun"},{"surface":" ","isWord":false},{"surface":"thích","isWord":true,"lemma":"thích","lexKey":"thích","syllables":[{"text":"thích","initial":"th","medial":"","nucleus":"i","final":"ch","tone":"sac"}],"pos":"verb"},{"surface":" ","isWord":false},{"surface":"hoa mai","isWord":true,"lemma":"hoa mai","lexKey":"hoa mai","syllables":[{"text":"hoa","initial":"h","medial":"o","nucleus":"a","final":"","tone":"ngang"},{"text":"mai","initial":"m","medial":"","nucleus":"a","final":"i","tone":"ngang"}],"pos":"noun"},{"surface":" ","isWord":false},{"surface":"vàng","isWord":true,"lemma":"vàng","lexKey":"vàng","syllables":[{"text":"vàng","initial":"v","medial":"","nucleus":"a","final":"ng","tone":"huyen"}],"pos":"adjective"},{"surface":".","isWord":false}]},"note":{"en":"A regional tradition: pink hoa đào (peach blossom) is the Tết flower of the North, yellow hoa mai (ochna / \"apricot\" blossom) that of the South.","ja":"地域による伝統の違いです。北部のテトの花はピンクの hoa đào（桃の花）、南部では黄色い hoa mai（マイの花）です。"}},{"id":"vi-culture-tet#5","index":5,"start":11.927,"end":13.591,"text":"Cả gia đình cùng nhau gói bánh chưng.","translations":{"en":"The whole family wraps bánh chưng together.","ja":"家族みんなでバインチュンを包みます。"},"analysis":{"lang":"vi","tokens":[{"surface":"Cả","isWord":true,"lemma":"cả","lexKey":"cả","syllables":[{"text":"Cả","initial":"c","medial":"","nucleus":"a","final":"","tone":"hoi"}],"pos":"determiner"},{"surface":" ","isWord":false},{"surface":"gia đình","isWord":true,"lemma":"gia đình","lexKey":"gia đình","syllables":[{"text":"gia","initial":"gi","medial":"","nucleus":"a","final":"","tone":"ngang"},{"text":"đình","initial":"đ","medial":"","nucleus":"i","final":"nh","tone":"huyen"}],"pos":"noun"},{"surface":" ","isWord":false},{"surface":"cùng nhau","isWord":true,"lemma":"cùng nhau","lexKey":"cùng nhau","syllables":[{"text":"cùng","initial":"c","medial":"","nucleus":"u","final":"ng","tone":"huyen"},{"text":"nhau","initial":"nh","medial":"","nucleus":"a","final":"u","tone":"ngang"}],"pos":"adverb"},{"surface":" ","isWord":false},{"surface":"gói","isWord":true,"lemma":"gói","lexKey":"gói","syllables":[{"text":"gói","initial":"g","medial":"","nucleus":"o","final":"i","tone":"sac"}],"pos":"verb"},{"surface":" ","isWord":false},{"surface":"bánh chưng","isWord":true,"lemma":"bánh chưng","lexKey":"bánh chưng","syllables":[{"text":"bánh","initial":"b","medial":"","nucleus":"a","final":"nh","tone":"sac"},{"text":"chưng","initial":"ch","medial":"","nucleus":"ư","final":"ng","tone":"ngang"}],"pos":"noun"},{"surface":".","isWord":false}]}},{"id":"vi-culture-tet#6","index":6,"start":14.191,"end":16.559,"text":"Bánh chưng làm từ gạo nếp, đậu xanh và thịt lợn.","translations":{"en":"Bánh chưng is made from sticky rice, mung beans and pork.","ja":"バインチュンはもち米、緑豆、豚肉で作ります。"},"analysis":{"lang":"vi","tokens":[{"surface":"Bánh chưng","isWord":true,"lemma":"bánh chưng","lexKey":"bánh chưng","syllables":[{"text":"Bánh","initial":"b","medial":"","nucleus":"a","final":"nh","tone":"sac"},{"text":"chưng","initial":"ch","medial":"","nucleus":"ư","final":"ng","tone":"ngang"}],"pos":"noun"},{"surface":" ","isWord":false},{"surface":"làm","isWord":true,"lemma":"là