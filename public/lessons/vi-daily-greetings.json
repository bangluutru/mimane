{"id":"vi-daily-greetings","schemaVersion":1,"origin":"catalog","title":{"original":"Xin chào!","en":"Hello! Everyday Greetings","ja":"こんにちは！毎日のあいさつ"},"description":{"vi":"Những câu chào hỏi, giới thiệu bản thân và cảm ơn đơn giản nhất trong tiếng Việt.","en":"The simplest Vietnamese phrases for greeting people, introducing yourself and saying thank you.","ja":"あいさつ、自己紹介、お礼など、ベトナム語のいちばん基本的な表現です。"},"targetLanguage":"vi","supportLanguages":["en","ja"],"media":{"kind":"file","mediaType":"audio","url":"media/vi-daily-greetings.mp3"},"durationSec":18.65,"sentenceCount":12,"categories":["daily-life"],"tags":["greetings","introductions","pronouns","politeness","basics"],"difficulty":{"framework":"vi-level","level":"beginner"},"accent":"vi-north","speakers":["Trúc Ly"],"source":{"kind":"prepared","synthetic":true,"attribution":"Mimane demo lesson · VieNeu-TTS v3 Turbo (Trúc Ly)","license":"CC BY 4.0"},"author":"Mimane","createdAt":"2026-09-26T11:15:34.333Z","updatedAt":"2026-09-26T11:15:34.333Z","sentences":[{"id":"vi-daily-greetings#0","index":0,"start":0.4,"end":0.967,"text":"Xin chào!","translations":{"en":"Hello!","ja":"こんにちは！"},"analysis":{"lang":"vi","tokens":[{"surface":"Xin chào","isWord":true,"lemma":"xin chào","lexKey":"xin chào","syllables":[{"text":"Xin","initial":"x","medial":"","nucleus":"i","final":"n","tone":"ngang"},{"text":"chào","initial":"ch","medial":"","nucleus":"a","final":"o","tone":"huyen"}],"pos":"expression"},{"surface":"!","isWord":false}]}},{"id":"vi-daily-greetings#1","index":1,"start":1.567,"end":2.407,"text":"Em chào chị ạ.","translations":{"en":"Hello (to an older woman).","ja":"（年上の女性に）こんにちは。"},"analysis":{"lang":"vi","tokens":[{"surface":"Em","isWord":true,"lemma":"em","lexKey":"em","syllables":[{"text":"Em","initial":"","medial":"","nucleus":"e","final":"m","tone":"ngang"}],"pos":"pronoun"},{"surface":" ","isWord":false},{"surface":"chào","isWord":true,"lemma":"chào","lexKey":"chào","syllables":[{"text":"chào","initial":"ch","medial":"","