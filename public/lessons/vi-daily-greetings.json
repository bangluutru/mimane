:[{"text":"em","initial":"","medial":"","nucleus":"e","final":"m","tone":"ngang"}],"pos":"pronoun"},{"surface":" ","isWord":false},{"surface":"thì sao","isWord":true,"lemma":"thì sao","lexKey":"thì sao","syllables":[{"text":"thì","initial":"th","medial":"","nucleus":"i","final":"","tone":"huyen"},{"text":"sao","initial":"s","medial":"","nucleus":"a","final":"o","tone":"ngang"}],"pos":"expression"},{"surface":"?","isWord":false}]}},{"id":"vi-daily-greetings#5","index":5,"start":8.104,"end":8.896,"text":"Em cũng khỏe ạ.","translations":{"en":"I'm fine too.","ja":"私も元気です。"},"analysis":{"lang":"vi","tokens":[{"surface":"Em","isWord":true,"lemma":"em","lexKey":"em","syllables":[{"text":"Em","initial":"","medial":"","nucleus":"e","final":"m","tone":"ngang"}],"pos":"pronoun"},{"surface":" ","isWord":false},{"surface":"cũng","isWord":true,"lemma":"cũng","lexKey":"cũng","syllables":[{"text":"cũng","initial":"c","medial":"","nucleus":"u","final":"ng","tone":"nga"}],"pos":"adverb"},{"surface":" ","isWord":false},{"surface":"khỏe","isWord":true,"lemma":"khỏe","lexKey":"khỏe","syllables":[{"text":"khỏe","initial":"kh","medial":"o","nucleus":"e","final":"","tone":"hoi"}],"pos":"adjective"},{"surface":" ","isWord":false},{"surface":"ạ","isWord":true,"lemma":"ạ","lexKey":"ạ","syllables":[{"text":"ạ","initial":"","medial":"","nucleus":"a","final":"","tone":"nang"}],"pos":"particle"},{"surface":".","isWord":false}]},"note":{"en":"Tone check: cũng has the ngã tone (~, rising with a catch in the throat) and khỏe has the hỏi tone (hook, low dipping). Northern speakers keep them distinct; in the South they sound alike.","ja":"声調に注意：cũng は ngã 声調（~、喉を締めて上がる）、khỏe は hỏi 声調（フック、低く下がる）。北部では区別しますが、南部ではほぼ同じに聞こえます。"}},{"id":"vi-daily-greetings#6","index":6,"start":9.496,"end":10.257,"text":"Tôi tên là Linh.","translations":{"en":"My name is Linh.","ja":"私の名前はリンです。"},"analysis":{"lang":"vi","tokens":[{"surface":"Tôi","isWord":true,"lemma":"tôi","lexKey":"tôi","syllables":[{"text":"Tôi","initial"